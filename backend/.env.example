# Copy to .env in the backend hosting environment. Never commit real secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://fpc_user:CHANGE_ME@localhost:5432/fpc
# Comma-separated exact frontend origins; no wildcard in production.
ALLOWED_ORIGINS=http://localhost:8080,https://realizanbernie.github.io
# Set true only when the hosting platform requires TLS connections to PostgreSQL.
PG_SSL=false